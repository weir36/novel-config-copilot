# 复制为 .env 后按需修改。所有项都有默认值，不配也能跑（走本地降级实现）。

# ---------------- LLM ----------------
# 任意 OpenAI-compatible 网关都可以。不配 API_KEY 时自动走 MockLLM，
# 检索与图谱链路仍然真实执行，只有生成环节是占位文本。
#
# DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
#
# 火山方舟（豆包）
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=doubao-pro-32k
#
# 阿里百炼（通义千问）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
#
# 自建 vLLM
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=Qwen2.5-14B-Instruct

# 离线抽取可以用更强的模型（这一步不在线上链路里，慢一点没关系）
# EXTRACT_MODEL=deepseek-reasoner

LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=4

# ---------------- 后端选择 ----------------
# auto = 探测得到就用真实组件，探测不到自动降级并在启动日志打印实际选择
VECTOR_BACKEND=auto        # auto | faiss | numpy
KEYWORD_BACKEND=auto       # auto | es | bm25
GRAPH_BACKEND=auto         # auto | neo4j | networkx
MEMORY_BACKEND=auto        # auto | redis | inproc
EMBEDDING_BACKEND=auto     # auto | bge | tfidf

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------------- 外部组件 ----------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=livecopilot

REDIS_URL=redis://localhost:6379/0
REDIS_TTL_S=3600

ES_URL=http://localhost:9200

# ---------------- 检索超参 ----------------
ENTITY_LINK_TOP_K=5
GRAPH_HOPS=2
GRAPH_MAX_NODES=40
GRAPH_QUERY_ENTITIES=6
GRAPH_ENTITY_QUERY_WEIGHT=0.55
VECTOR_TOP_K=12
BM25_TOP_K=12
FUSION_STRATEGY=weighted   # weighted | rrf
FUSION_W_VECTOR=0.6
FUSION_W_BM25=0.4
FINAL_TOP_K=6
FINAL_MIN_SCORE=0.22

# ---------------- Agent ----------------
AGENT_ENABLED=true
AGENT_MAX_STEPS=6

LOG_LEVEL=INFO
